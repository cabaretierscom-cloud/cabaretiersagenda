# Instellingen voor de webserver (Apache bij Cloud86/Plesk).
# https afdwingen doet Plesk zelf (SSL/TLS: "Permanent SEO-safe 301 redirect from HTTP to HTTPS").

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# cabaretiers.com zonder www -> https://www.cabaretiers.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^cabaretiers\.com$ [NC]
  RewriteRule ^ https://www.cabaretiers.com%{REQUEST_URI} [L,R=301]
  # Plaatspagina's heetten tot november 2026 /plaatsen/<plaats>/; het overzicht /plaatsen/ blijft.
  RewriteRule ^plaatsen/([^/]+)/?$ https://www.cabaretiers.com/theaters-in-$1/ [L,R=301]
  RewriteRule ^plaatsen/([^/]+)/(vanavond|dit-weekend)/?$ https://www.cabaretiers.com/theaters-in-$1/$2/ [L,R=301]
  # Vanavond/dit weekend per stad bestaat alleen bij genoeg aanbod; anders naar de plaatspagina.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^theaters-in-([^/]+)/(vanavond|dit-weekend)/?$ https://www.cabaretiers.com/theaters-in-$1/ [L,R=301]
</IfModule>

# Lettertypes, afbeeldingen, CSS en JS mogen een tijd in de browser blijven;
# pagina's niet, want de agenda verandert elke nacht.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

