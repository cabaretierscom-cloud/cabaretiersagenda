# Instellingen voor de webserver (Apache bij Cloud86/Plesk).
# https afdwingen doet Plesk zelf (SSL/TLS: "Permanent SEO-safe 301 redirect from HTTP to HTTPS").

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest

# cabaretiers.com zonder www -> https://www.cabaretiers.com
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^cabaretiers\.com$ [NC]
  RewriteRule ^ https://www.cabaretiers.com%{REQUEST_URI} [L,R=301]
  # Plaatspagina's heetten tot november 2026 /plaatsen/<plaats>/; het overzicht /plaatsen/ blijft.
  RewriteRule ^plaatsen/([^/]+)/?$ https://www.cabaretiers.com/theaters-in-$1/ [L,R=301]
  RewriteRule ^plaatsen/([^/]+)/(vanavond|dit-weekend)/?$ https://www.cabaretiers.com/theaters-in-$1/ [L,R=301]
  # Genres stonden tot november 2026 onder /genres/; nu onder /agenda/ (ook /genres/ zelf).
  # Dubbele artiesten samengevoegd (november 2026).
  RewriteRule ^artiesten/beperkt-houdbaar(/.*)?$ https://www.cabaretiers.com/artiesten/andries-tunru-en-stefan-hendrikx/ [L,R=301]
  RewriteRule ^artiesten/bert-visscher-en-het-noordpool-strijkkwartet(/.*)?$ https://www.cabaretiers.com/artiesten/bert-visscher/ [L,R=301]
  RewriteRule ^artiesten/comedy-comedians(/.*)?$ https://www.cabaretiers.com/artiesten/martijn-koning/ [L,R=301]
  RewriteRule ^artiesten/ddt-houdt-uitverkoop(/.*)?$ https://www.cabaretiers.com/artiesten/jacques-vermeire/ [L,R=301]
  RewriteRule ^artiesten/de-vrouwejaars(/.*)?$ https://www.cabaretiers.com/artiesten/vrouwejaars-2026/ [L,R=301]
  RewriteRule ^artiesten/klaas-van-eerden(/.*)?$ https://www.cabaretiers.com/artiesten/klaas-van-der-eerden/ [L,R=301]
  RewriteRule ^artiesten/marja-van-katendrecht-x-theater-zuidplein(/.*)?$ https://www.cabaretiers.com/artiesten/marja-van-katendrecht/ [L,R=301]
  RewriteRule ^artiesten/tis-hier-geen-hotel-3(/.*)?$ https://www.cabaretiers.com/artiesten/hanneke-drenth-en-dianne-liesker/ [L,R=301]
  # Kor Hoebe: de voorstelling heet Korrelatie, niet Korrelrelatie (november 2026).
  RewriteRule ^artiesten/kor-hoebe/korrelrelatie/?$ https://www.cabaretiers.com/artiesten/kor-hoebe/korrelatie/ [L,R=301]
  # Het genre theaterkomedie heet sinds november 2026 komedie.
  RewriteRule ^(genres|agenda)/theaterkomedie(/.*)?$ https://www.cabaretiers.com/agenda/komedie$2 [L,R=301]
  RewriteRule ^genres/?$ https://www.cabaretiers.com/agenda/ [L,R=301]
  RewriteRule ^genres/(.+)$ https://www.cabaretiers.com/agenda/$1 [L,R=301]
  # Cabaret per plaats bestaat alleen vanaf drie voorstellingen (GENRE_PLAATS_DREMPEL); anders naar de plaatspagina.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^agenda/cabaret/([^/]+)/?$ https://www.cabaretiers.com/theaters-in-$1/ [L,R=301]
  # Vanavond/dit weekend per stad bestaat niet meer (dubbel met de plaatspagina): altijd naar de plaatspagina.
  RewriteRule ^theaters-in-([^/]+)/(vanavond|dit-weekend)/?$ https://www.cabaretiers.com/theaters-in-$1/ [L,R=301]
</IfModule>

# Lettertypes, afbeeldingen, CSS en JS mogen een tijd in de browser blijven;
# pagina's niet, want de agenda verandert elke nacht.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

